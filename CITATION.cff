    given-names: Pablo
    orcid: 'https://orcid.org/0000-0003-1083-2460'
version: 0.1.0
date-released: '2026-06-07'
license: MIT
# repository-code is a placeholder until the public repository is created.
repository-code: 'https://github.com/pablobernabeu/lexsync'
keywords:
  - psycholinguistics
  - lexical statistics
  - stimulus matching
  - counterbalancing
  - pseudoword generation
  - EEG
  - ERP
  - PsychoPy
  - OpenSesame
  - jsPsych
  - FAIR
