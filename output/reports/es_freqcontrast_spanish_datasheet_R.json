{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "es_freqcontrast",
    "language": "spanish",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "High versus low frequency Spanish words, matched on length, neighbourhood density and OLD20.",
    "n_per_condition": 80
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/es.csv",
    "sha256": "e9f93013c16ec9745c0d02f82c697f2488c328365b95b57c5f04ac2565c123ea",
    "provenance": "wordfreq (Speer, 2022), data CC BY-SA 4.0; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "candidate_pool": [
      {
        "condition": "high_frequency",
        "n_candidates": 466
      },
      {
        "condition": "low_frequency",
        "n_candidates": 4689
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ condition + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017). The formula is lme4 syntax, for lme4 in R or pymer4 in Python; statsmodels MixedLM cannot take it directly and needs the random effects restated in its own arguments. The equivalence tests in the realised control are post-selection diagnostics on deterministically selected items, not inferential tests over a sample."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0.049,
      "ci_low": -0.213,
      "ci_high": 0.31,
      "var_ratio": 0.83,
      "tost_p": 0.0024,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "manipulated/free",
      "cohens_d": 5.546,
      "ci_low": 4.97,
      "ci_high": 6.122,
      "var_ratio": 0.298,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "n_density",
      "role": "controlled",
      "cohens_d": 0.077,
      "ci_low": -0.185,
      "ci_high": 0.339,
      "var_ratio": 0.61,
      "tost_p": 0.0041,
      "equivalent": true
    },
    {
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": 0.006,
      "ci_low": -0.255,
      "ci_high": 0.268,
      "var_ratio": 0.959,
      "tost_p": 0.0011,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "high_frequency",
        "n_trials": 80
      },
      {
        "list": 1,
        "condition": "low_frequency",
        "n_trials": 80
      }
    ],
    "versions": 1,
    "assignment": "version = ((participant - 1) mod 1) + 1 unless a version is given at launch"
  },
  "resampling": null,
  "items": {
    "n_total": 160,
    "n_conditions": 2,
    "conditions": [
      "low_frequency",
      "high_frequency"
    ],
    "stimuli_file": "output/stimuli/es_freqcontrast_spanish_stimuli_R.csv",
    "stimuli_sha256": "b54cc7620b347008feabb5e84f432c0a72e6b5f0add3d83eabef9fea259f8be8"
  },
  "reproducibility": {
    "seed": 2026,
    "versions": {
