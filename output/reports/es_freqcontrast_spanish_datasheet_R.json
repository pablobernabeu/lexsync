{
  "lexsync_datasheet_version": "1.0",
  "design": {
    "name": "es_freqcontrast",
    "language": "spanish",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "High versus low frequency Spanish words, matched on length, neighbourhood density and OLD20.",
    "n_per_condition": 80
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/es.csv",
    "sha256": "02732e5f00d09951b97ab8d5bdc285c321894ccb49d5c20b7afe39335a8204d9",
    "provenance": "see corpora/ATTRIBUTION.md for corpus licence and citation"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "letters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean positional bigram probability"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "candidate_pool": [
      {
        "condition": "high_frequency",
        "n_candidates": 466
      },
      {
        "condition": "low_frequency",
        "n_candidates": 4689
      }
    ],
    "cross_engine": "byte-identical"
  },
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ condition + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017); fit with lme4 in R or pymer4/statsmodels in Python."
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0.049,
      "ci_low": -0.213,
      "ci_high": 0.31,
      "var_ratio": 0.83,
      "tost_p": 0.0024,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "manipulated/free",
      "cohens_d": 5.546,
      "ci_low": 5.285,
      "ci_high": 5.808,
      "var_ratio": 0.298,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "n_density",
      "role": "controlled",
      "cohens_d": 0.077,
      "ci_low": -0.184,
      "ci_high": 0.339,
      "var_ratio": 0.61,
      "tost_p": 0.0041,
      "equivalent": true
    },
    {
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": 0.006,
      "ci_low": -0.255,
      "ci_high": 0.268,
      "var_ratio": 0.959,
      "tost_p": 0.0011,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": null,
  "items": {
    "n_total": 160,
    "n_conditions": 2,
    "conditions": [
      "low_frequency",
      "high_frequency"
    ],
    "stimuli_file": "output/stimuli/es_freqcontrast_spanish_stimuli_R.csv",
    "stimuli_sha256": "9e964c582d1acbedcecf3afe9bf6b7faf29b5059f906f390dd50b0a3a5366e84"
  },
  "reproducibility": {
    "seed": 2026,
    "versions": {
