{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "en_lexdec",
    "language": "english",
    "paradigm": "lexical_decision",
    "source": "generate",
    "description": "Lexical decision: real words versus length-matched, orthographically legal pseudowords (deterministically generated).",
    "n_per_condition": 60
  },
  "materials_source": {
    "type": "generate",
    "path": "corpora/derived/en.csv",
    "sha256": "575833489e04d6a4001fda56a56e3daa383811dece1f819c44060ee79ca56976",
    "provenance": "wordfreq (Speer, 2022), data CC BY-SA 4.0; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    }
  },
  "selection": {
    "method": "constrained letter substitution (deterministic pseudowords)",
    "generation_method": "letter_substitution",
    "matched_on": [
      "length"
    ],
    "candidate_pool": [
      {
        "condition": "words in band",
        "n_candidates": 8177
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ lexicality + (1 + lexicality | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017). The formula is lme4 syntax, for lme4 in R or pymer4 in Python; statsmodels MixedLM cannot take it directly and needs the random effects restated in its own arguments. The equivalence tests in the realised control are post-selection diagnostics on deterministically selected items, not inferential tests over a sample."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0,
      "ci_low": -0.303,
      "ci_high": 0.303,
      "var_ratio": 1,
      "tost_p": 0.0036,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "pseudoword",
        "n_trials": 60
      },
      {
        "list": 1,
        "condition": "word",
        "n_trials": 60
      }
    ],
    "versions": 1,
    "assignment": "version = ((participant - 1) mod 1) + 1 unless a version is given at launch"
  },
  "resampling": null,
  "items": {
    "n_total": 120,
    "n_conditions": 2,
    "conditions": [
      "pseudoword",
      "word"
    ],
    "stimuli_file": "output/stimuli/en_lexdec_english_stimuli_R.csv",
