      "ci_high": -0.88,
      "var_ratio": 0.662,
      "tost_p": 0.9999,
      "equivalent": false,
      "mean_diff": -0.004
    },
    {
      "condition": "pseudoword",
      "reference": "word",
      "dimension": "n_density",
      "role": "uncontrolled",
      "cohens_d": 0,
      "ci_low": -0.303,
      "ci_high": 0.303,
      "var_ratio": 0.483,
      "tost_p": 0.0036,
      "equivalent": true,
      "mean_diff": 0
    },
    {
      "condition": "pseudoword",
      "reference": "word",
      "dimension": "old20",
      "role": "uncontrolled",
      "cohens_d": 0.021,
      "ci_low": -0.282,
      "ci_high": 0.323,
      "var_ratio": 0.645,
      "tost_p": 0.0049,
      "equivalent": true,
      "mean_diff": 0.007
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "pseudoword",
        "n_trials": 60
      },
      {
        "list": 1,
        "condition": "word",
        "n_trials": 60
      }
    ],
    "versions": 1,
    "assignment": "version = ((participant - 1) mod 1) + 1 unless a version is given at launch"
  },
  "presentation": {
    "response_windows": [
      {
        "event": 3,
        "from": "onset",
        "window_ms": 2800
      }
    ],
    "response_mapping": {
      "conditions": {
        "word": "left",
        "pseudoword": "right"
      },
      "keys": [
        "left",
        "right"
      ],
      "rotate_by_list": false,
      "source": "default"
    }
  },
  "resampling": null,
