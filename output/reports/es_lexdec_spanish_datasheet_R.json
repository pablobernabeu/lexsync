{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "es_lexdec",
    "language": "spanish",
    "paradigm": "lexical_decision",
    "source": "generate",
    "description": "Spanish lexical decision: real words, accented ones included, versus length-matched, orthographically legal pseudowords (deterministically generated).",
    "n_per_condition": 60
  },
  "materials_source": {
    "type": "generate",
    "path": "corpora/derived/es.csv",
    "sha256": "e9f93013c16ec9745c0d02f82c697f2488c328365b95b57c5f04ac2565c123ea",
    "provenance": "wordfreq (Speer, 2022), data CC BY-SA 4.0; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    }
  },
  "selection": {
    "method": "constrained letter substitution (deterministic pseudowords)",
    "generation_method": "letter_substitution",
    "matched_on": [
      "length"
    ],
    "candidate_pool": [
      {
        "condition": "words in band",
        "n_candidates": 8305
      }
    ],
    "cross_engine": "byte-identical",
    "generation_exclude": [
      {
        "source": "corpora/derived/es_known_forms.txt",
