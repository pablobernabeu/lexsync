      "cohens_d": 0.13,
      "ci_low": -0.403,
      "ci_high": 0.663,
      "var_ratio": 0.832,
      "tost_p": 0.1245,
      "equivalent": false
    },
    {
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": -0.241,
      "ci_low": -0.775,
      "ci_high": 0.292,
      "var_ratio": 0.624,
      "tost_p": 0.2093,
      "equivalent": false
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": null,
  "items": {
    "n_total": 40,
    "n_conditions": 2,
    "conditions": [
      "lower_frequency",
