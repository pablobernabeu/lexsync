{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "en_supplied_pool",
    "language": "english",
    "paradigm": "factorial",
    "source": "pool",
    "description": "Concrete nouns from a supplied candidate pool, split by frequency and matched item by item on length, neighbourhood density and OLD20.",
    "n_per_condition": 20
  },
  "materials_source": {
    "type": "pool",
    "path": "items/pool_en_concrete_nouns.csv",
    "sha256": "09d0706a853b4bb30580e892a64061835db0f460ee7595b674a2fc8f56d5775f",
    "provenance": "user-supplied word pool, matched by lexsync",
    "dimensions_from": "corpora/derived/en_v2.csv",
    "dimensions_sha256": "46815cd56ac036cb841460a2ea6205ac374eddb6ca26275bb1a2fbafc7c5d626"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "tie_break": {
      "rule": "hash",
      "salt": "lexsync-tie-v1"
    },
    "candidate_pool": [
      {
        "condition": "higher_frequency",
        "n_candidates": 31
      },
      {
        "condition": "lower_frequency",
        "n_candidates": 95
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "reaction time from the onset of `{word}`; responses collected for 2500 ms; a response ends the trial",
    "suggested_model": "response ~ condition + scale(length, scale = FALSE) + scale(n_density, scale = FALSE) + scale(old20, scale = FALSE) + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). The matched dimensions enter as centred covariates, computed from the stimuli file's own columns, because matching leaves residual differences that the analysis can adjust for (Sassenhagen & Alday, 2016). Begin with random slopes for condition, the manipulated factor, by subject and, where it varies within items, by item (Barr et al., 2013); the matched covariates enter as fixed effects only. If the model is singular or fails to converge, simplify it as Matuschek et al. (2017) describe. The formula is lme4 syntax, for lme4 in R or pymer4 in Python; statsmodels MixedLM cannot take it directly and needs the random effects restated in its own arguments. The equivalence tests in the realised control are post-selection diagnostics on deterministically selected items, not inferential tests over a sample."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "condition": "lower_frequency",
      "reference": "higher_frequency",
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0,
      "ci_low": -0.533,
      "ci_high": 0.533,
      "var_ratio": 1,
      "tost_p": 0.0611,
      "equivalent": false,
      "mean_diff": 0
    },
    {
      "condition": "lower_frequency",
      "reference": "higher_frequency",
      "dimension": "frequency",
      "role": "manipulated",
      "cohens_d": 3.512,
      "ci_low": 2.662,
      "ci_high": 4.362,
      "var_ratio": 0.831,
      "tost_p": 1,
      "equivalent": false,
      "mean_diff": 1.018
    },
    {
      "condition": "lower_frequency",
      "reference": "higher_frequency",
      "dimension": "n_density",
      "role": "controlled",
      "cohens_d": 0.178,
      "ci_low": -0.357,
      "ci_high": 0.712,
      "var_ratio": 0.644,
      "tost_p": 0.1572,
      "equivalent": false,
      "mean_diff": 0.35
    },
    {
      "condition": "lower_frequency",
      "reference": "higher_frequency",
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": -0.14,
      "ci_low": -0.674,
      "ci_high": 0.394,
      "var_ratio": 0.604,
      "tost_p": 0.1309,
      "equivalent": false,
      "mean_diff": -0.04
    },
    {
      "condition": "lower_frequency",
      "reference": "higher_frequency",
      "dimension": "n_syllables",
      "role": "uncontrolled",
      "cohens_d": 0.139,
      "ci_low": -0.395,
      "ci_high": 0.672,
      "var_ratio": 0.238,
      "tost_p": 0.1301,
      "equivalent": false,
      "mean_diff": 0.05
    },
    {
      "condition": "lower_frequency",
      "reference": "higher_frequency",
      "dimension": "bigram_freq",
      "role": "uncontrolled",
      "cohens_d": 0.624,
      "ci_low": 0.078,
      "ci_high": 1.17,
      "var_ratio": 0.426,
      "tost_p": 0.651,
      "equivalent": false,
      "mean_diff": 0.001
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "higher_frequency",
        "n_trials": 20
      },
      {
        "list": 1,
        "condition": "lower_frequency",
        "n_trials": 20
      }
    ],
    "versions": 1,
    "assignment": "version = ((participant - 1) mod 1) + 1 unless a version is given at launch"
  },
  "presentation": {
    "response_windows": [
      {
        "event": 3,
        "from": "onset",
        "window_ms": 2500
      }
    ]
  },
  "resampling": null,
  "items": {
    "n_total": 40,
    "n_conditions": 2,
    "conditions": [
      "lower_frequency",
      "higher_frequency"
    ],
    "n_per_condition_realised": [
      {
        "condition": "lower_frequency",
        "n": 20
      },
      {
        "condition": "higher_frequency",
        "n": 20
      }
    ],
    "stimuli_file": "output/stimuli/en_supplied_pool_english_stimuli_R.csv",
    "stimuli_sha256": "e8fdf3e32d5d5f8a35776cac98ebfbf44774470deb7f99a1c4a2314f223a9536"
  },
