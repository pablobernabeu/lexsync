      "equivalent": false
    },
    {
      "dimension": "old20",
      "role": "manipulated/free",
      "cohens_d": -2.304,
      "ci_low": -2.565,
      "ci_high": -2.042,
      "tost_p": 1,
      "equivalent": false
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": null,
  "items": {
    "n_total": 160,
    "n_conditions": 2,
    "conditions": [
      "sparse_neighbourhood",
