{
  "lexsync_datasheet_version": "1.1",
  "design": {
    "name": "en_ndensity",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "Dense versus sparse orthographic neighbourhoods (Coltheart's N) in English, matched on length and frequency.",
    "n_per_condition": 80
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en.csv",
    "sha256": "c20549b920d816809d11cfa673ad0df1dd70d3e73176ee66cbec18021627f65d",
    "provenance": "wordfreq (Speer, 2022), data CC BY-SA 4.0; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "letters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean positional bigram probability"
    }
  },
  "selection": {
    "method": "joint",
    "match_on": [
      "length",
      "frequency"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "candidate_pool": [
      {
        "condition": "dense_neighbourhood",
        "n_candidates": 1821
      },
      {
        "condition": "sparse_neighbourhood",
        "n_candidates": 1528
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ condition + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017); fit with lme4 in R or pymer4/statsmodels in Python."
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0,
      "ci_low": -0.262,
      "ci_high": 0.262,
      "var_ratio": 1,
      "tost_p": 0.0009,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "controlled",
      "cohens_d": 0,
      "ci_low": -0.262,
      "ci_high": 0.262,
      "var_ratio": 1,
      "tost_p": 0.0009,
      "equivalent": true
    },
    {
      "dimension": "n_density",
      "role": "manipulated/free",
      "cohens_d": 3.108,
      "ci_low": 2.847,
      "ci_high": 3.37,
      "var_ratio": 0.02,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "old20",
      "role": "manipulated/free",
      "cohens_d": -2.304,
      "ci_low": -2.565,
      "ci_high": -2.042,
      "var_ratio": 1.639,
      "tost_p": 1,
      "equivalent": false
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": null,
  "items": {
    "n_total": 160,
    "n_conditions": 2,
    "conditions": [
      "dense_neighbourhood",
      "sparse_neighbourhood"
    ],
    "stimuli_file": "output/stimuli/en_ndensity_english_stimuli_R.csv",
    "stimuli_sha256": "9b9164e7708f68ea3519e9fcd9389bf903b4e34aba987902b0881de57a22488f"
  },
  "reproducibility": {
