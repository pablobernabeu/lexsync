{
  "lexsync_datasheet_version": "1.0",
  "design": {
    "name": "en_ndensity",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "Dense versus sparse orthographic neighbourhoods (Coltheart's N) in English, matched on length and frequency.",
    "n_per_condition": 80
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en.csv",
    "sha256": "c20549b920d816809d11cfa673ad0df1dd70d3e73176ee66cbec18021627f65d",
    "provenance": "see corpora/ATTRIBUTION.md for corpus licence and citation"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "letters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean positional bigram probability"
    }
  },
  "selection": {
    "method": "joint",
    "match_on": [
      "length",
      "frequency"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "candidate_pool": [
      {
        "condition": "dense_neighbourhood",
        "n_candidates": 1821
      },
      {
        "condition": "sparse_neighbourhood",
        "n_candidates": 1528
      }
    ],
    "cross_engine": "byte-identical"
  },
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ condition + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017); fit with lme4 in R or pymer4/statsmodels in Python."
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0,
      "ci_low": -0.262,
      "ci_high": 0.262,
      "tost_p": 0.0009,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "controlled",
      "cohens_d": 0,
      "ci_low": -0.262,
      "ci_high": 0.262,
      "tost_p": 0.0009,
      "equivalent": true
    },
    {
