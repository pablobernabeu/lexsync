{
  "lexsync_datasheet_version": "1.1",
  "design": {
    "name": "en_balanced_lists",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "High versus low frequency English words, matched on length, neighbourhood density and OLD20, dealt into four counterbalancing lists that are themselves equated on those dimensions.",
    "n_per_condition": 40
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en.csv",
    "sha256": "c20549b920d816809d11cfa673ad0df1dd70d3e73176ee66cbec18021627f65d",
    "provenance": "wordfreq (Speer, 2022), data CC BY-SA 4.0; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "letters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean positional bigram probability"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "candidate_pool": [
      {
        "condition": "high_frequency",
        "n_candidates": 544
      },
      {
        "condition": "low_frequency",
        "n_candidates": 4295
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ condition + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017); fit with lme4 in R or pymer4/statsmodels in Python."
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0.022,
      "ci_low": -0.35,
      "ci_high": 0.394,
      "var_ratio": 0.897,
      "tost_p": 0.0178,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "manipulated/free",
      "cohens_d": 5.055,
      "ci_low": 4.682,
      "ci_high": 5.427,
      "var_ratio": 0.201,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "n_density",
      "role": "controlled",
      "cohens_d": 0.05,
      "ci_low": -0.322,
      "ci_high": 0.422,
      "var_ratio": 0.745,
      "tost_p": 0.0237,
      "equivalent": true
    },
    {
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": 0.053,
      "ci_low": -0.319,
      "ci_high": 0.426,
      "var_ratio": 0.676,
      "tost_p": 0.0246,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 4,
    "optimise": {
      "dimensions": [
        "length",
        "n_density",
        "old20",
        "frequency"
      ],
      "cost_before": 1121480,
      "cost_after": 53820,
      "n_swaps": 10,
      "max_passes_reached": false,
      "cost_unit": "summed absolute deviation of each list's dimension total from its fair share, in milli-units of the dimension's mean, scaled by the number of item sets"
    }
  },
  "resampling": null,
  "items": {
    "n_total": 80,
    "n_conditions": 2,
    "conditions": [
      "low_frequency",
      "high_frequency"
    ],
    "stimuli_file": "output/stimuli/en_balanced_lists_english_stimuli_R.csv",
    "stimuli_sha256": "c2315baac536c882744e53cb65f08026bcc77bc4266b2a48dc616159614b6aa2"
  },
  "reproducibility": {
    "seed": 2026,
    "versions": {
      "engine": "R",
      "lexsync": "0.1.0",
      "R": "4.6.1",
      "readr": "2.2.0",
      "stringdist": "0.9.17",
      "jsonlite": "2.0.0",
      "digest": "0.6.39"
    }
  },
  "artifacts": [
