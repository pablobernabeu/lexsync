{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "en_freqcontinuous",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "English words spread over the ranks of frequency in the pool, with the tails of length, neighbourhood density and OLD20 trimmed by tolerance windows, for regression / mixed-model analysis.",
    "n_per_condition": 80
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en_v2.csv",
    "sha256": "46815cd56ac036cb841460a2ea6205ac374eddb6ca26275bb1a2fbafc7c5d626",
    "provenance": "wordfreq (Speer, 2022) screened against SUBTLEX-US (Brysbaert & New, 2009), data CC BY-SA 4.0; forms absent from SUBTLEX-US or beginning with a lower-case letter in under 10% of their uses are marked nonstandard, and N and OLD20 count only the unmarked forms; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md",
    "exclusions": {
      "path": "config/exclude_en_demo.txt",
      "sha256": "cac9f88fb86fa6d0e6dbabc287c9ebb782100d071eeded13eb812584b9d41e9f",
      "n_listed": 53,
      "n_removed": 53
    }
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "continuous even-spread (predictor spanned, controls banded)",
    "predictor": "frequency",
    "controls": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 1.5,
      "frequency": 1,
      "n_density": 1.5,
      "old20": 1.5
    },
    "candidate_pool": [
      {
        "condition": "continuous",
        "n_candidates": 6308
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "reaction time from the onset of `{word}`; responses collected for 2800 ms; a response ends the trial",
    "suggested_model": "response ~ frequency + length + n_density + old20 + (1 + frequency | subject) + (1 | item)",
    "note": "The predictor is kept continuous and analysed by regression or a mixed model rather than dichotomised (Kuperman, 2015; Liben-Nowell et al., 2019); the controls enter as covariates. Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with a random slope for frequency by subject (Barr et al., 2013); the controls enter as fixed effects only. If the model is singular or fails to converge, simplify it as Matuschek et al. (2017) describe."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "dimension": "frequency",
      "role": "predictor",
      "pearson_r": null,
      "predictor_span": 3.05,
      "sd": 0.531,
      "sd_ratio": 0.592,
      "window_low": null,
      "window_high": null
    },
    {
      "dimension": "length",
      "role": "control",
      "pearson_r": -0.226,
      "predictor_span": 3.05,
      "sd": 1.116,
      "sd_ratio": 0.755,
      "window_low": 3.991,
      "window_high": 8.134
    },
    {
      "dimension": "n_density",
      "role": "control",
      "pearson_r": 0.301,
      "predictor_span": 3.05,
      "sd": 1.844,
      "sd_ratio": 0.409,
      "window_low": -2.516,
      "window_high": 7.541
    },
    {
      "dimension": "old20",
      "role": "control",
      "pearson_r": -0.295,
      "predictor_span": 3.05,
      "sd": 0.407,
      "sd_ratio": 0.68,
      "window_low": 1.29,
      "window_high": 2.913
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "continuous",
        "n_trials": 80
      }
    ],
    "versions": 1,
    "assignment": "version = ((participant - 1) mod 1) + 1 unless a version is given at launch"
  },
  "presentation": {
    "response_windows": [
      {
        "event": 3,
        "from": "onset",
        "window_ms": 2800
      }
    ]
  },
  "resampling": null,
  "items": {
    "n_total": 80,
