{
  "lexsync_datasheet_version": "1.1",
  "design": {
    "name": "en_freqcontinuous",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "English words spanning the frequency range continuously, with length, neighbourhood density and OLD20 held near-constant, for regression / mixed-model analysis.",
    "n_per_condition": 80
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en.csv",
    "sha256": "c20549b920d816809d11cfa673ad0df1dd70d3e73176ee66cbec18021627f65d",
    "provenance": "see corpora/ATTRIBUTION.md for corpus licence and citation"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "letters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean positional bigram probability"
    }
  },
  "selection": {
    "method": "continuous even-spread (predictor spanned, controls banded)",
    "predictor": "frequency",
    "controls": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 1.5,
      "frequency": 1,
      "n_density": 1.5,
      "old20": 1.5
    },
    "candidate_pool": [
      {
        "condition": "continuous",
        "n_candidates": 7230
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ frequency + length + n_density + old20 + (1 + frequency | subject) + (1 | item)",
    "note": "The predictor is kept continuous and analysed by regression or a mixed model rather than dichotomised (Kuperman, 2015; Liben-Nowell et al., 2019); the controls enter as covariates. Crossed random effects for subjects and items guard the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008); reduce the structure if it does not converge (Matuschek et al., 2017)."
  },
  "realised_control": [
    {
      "dimension": "frequency",
      "role": "predictor",
      "pearson_r": null,
      "predictor_span": 3.05
    },
    {
      "dimension": "length",
      "role": "control",
      "pearson_r": -0.165,
      "predictor_span": 3.05
    },
    {
      "dimension": "n_density",
      "role": "control",
      "pearson_r": -0.049,
      "predictor_span": 3.05
    },
    {
      "dimension": "old20",
      "role": "control",
      "pearson_r": -0.077,
      "predictor_span": 3.05
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": null,
  "items": {
    "n_total": 80,
    "n_conditions": 1,
    "conditions": [
      "continuous"
    ],
    "stimuli_file": "output/stimuli/en_freqcontinuous_english_stimuli_R.csv",
    "stimuli_sha256": "8151a0787d989557463f4d2ac5e1c11f5bb943283774da0ed66748724f54da2a"
  },
  "reproducibility": {
    "seed": 2026,
    "versions": {
      "engine": "R",
      "lexsync": "0.1.0",
      "R": "4.6.1",
      "readr": "2.2.0",
      "stringdist": "0.9.17",
      "jsonlite": "2.0.0",
      "digest": "0.6.39"
    }
  },
