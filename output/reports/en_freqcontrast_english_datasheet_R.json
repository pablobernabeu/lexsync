{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "en_freqcontrast",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "High versus low frequency English words, matched on length, neighbourhood density and OLD20.",
    "n_per_condition": 80
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en_v2.csv",
    "sha256": "46815cd56ac036cb841460a2ea6205ac374eddb6ca26275bb1a2fbafc7c5d626",
    "provenance": "wordfreq (Speer, 2022) screened against SUBTLEX-US (Brysbaert & New, 2009), data CC BY-SA 4.0; forms absent from SUBTLEX-US or beginning with a lower-case letter in under 10% of their uses are marked nonstandard, and N and OLD20 count only the unmarked forms; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md",
    "exclusions": {
      "path": "config/exclude_en_demo.txt",
      "sha256": "cac9f88fb86fa6d0e6dbabc287c9ebb782100d071eeded13eb812584b9d41e9f",
      "n_listed": 53,
      "n_removed": 53
    }
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "tie_break": {
      "rule": "hash",
      "salt": "lexsync-tie-v1"
    },
    "candidate_pool": [
      {
        "condition": "high_frequency",
        "n_candidates": 534
      },
      {
        "condition": "low_frequency",
        "n_candidates": 3583
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "reaction time from the onset of `{word}`; responses collected for 2500 ms; a response ends the trial",
    "suggested_model": "response ~ condition + scale(length, scale = FALSE) + scale(n_density, scale = FALSE) + scale(old20, scale = FALSE) + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). The matched dimensions enter as centred covariates, computed from the stimuli file's own columns, because matching leaves residual differences that the analysis can adjust for (Sassenhagen & Alday, 2016). Begin with random slopes for condition, the manipulated factor, by subject and, where it varies within items, by item (Barr et al., 2013); the matched covariates enter as fixed effects only. If the model is singular or fails to converge, simplify it as Matuschek et al. (2017) describe. The formula is lme4 syntax, for lme4 in R or pymer4 in Python; statsmodels MixedLM cannot take it directly and needs the random effects restated in its own arguments. The equivalence tests in the realised control are post-selection diagnostics on deterministically selected items, not inferential tests over a sample."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "condition": "low_frequency",
      "reference": "high_frequency",
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0.029,
      "ci_low": -0.233,
      "ci_high": 0.291,
      "var_ratio": 0.884,
      "tost_p": 0.0017,
      "equivalent": true,
      "mean_diff": 0.037
    },
    {
      "condition": "low_frequency",
      "reference": "high_frequency",
      "dimension": "frequency",
      "role": "manipulated",
      "cohens_d": 5.292,
      "ci_low": 4.737,
      "ci_high": 5.847,
      "var_ratio": 0.192,
      "tost_p": 1,
      "equivalent": false,
      "mean_diff": 1.513
    },
    {
      "condition": "low_frequency",
      "reference": "high_frequency",
      "dimension": "n_density",
      "role": "controlled",
      "cohens_d": 0.056,
      "ci_low": -0.206,
      "ci_high": 0.318,
      "var_ratio": 0.748,
      "tost_p": 0.0028,
      "equivalent": true,
      "mean_diff": 0.325
    },
    {
      "condition": "low_frequency",
      "reference": "high_frequency",
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": 0.022,
      "ci_low": -0.24,
      "ci_high": 0.283,
      "var_ratio": 0.824,
      "tost_p": 0.0015,
      "equivalent": true,
      "mean_diff": 0.011
    },
    {
      "condition": "low_frequency",
      "reference": "high_frequency",
      "dimension": "n_syllables",
      "role": "uncontrolled",
      "cohens_d": -0.02,
      "ci_low": -0.281,
      "ci_high": 0.242,
      "var_ratio": 1.288,
      "tost_p": 0.0014,
      "equivalent": true,
      "mean_diff": -0.012
    },
    {
      "condition": "low_frequency",
      "reference": "high_frequency",
      "dimension": "bigram_freq",
      "role": "uncontrolled",
      "cohens_d": 0.009,
      "ci_low": -0.252,
      "ci_high": 0.271,
      "var_ratio": 1.387,
      "tost_p": 0.0011,
      "equivalent": true,
      "mean_diff": 0
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "high_frequency",
        "n_trials": 80
      },
      {
        "list": 1,
        "condition": "low_frequency",
        "n_trials": 80
      }
    ],
    "versions": 1,
    "assignment": "version = ((participant - 1) mod 1) + 1 unless a version is given at launch"
  },
  "presentation": {
    "response_windows": [
      {
        "event": 3,
        "from": "onset",
        "window_ms": 2500
      }
    ]
  },
  "resampling": null,
  "items": {
    "n_total": 160,
    "n_conditions": 2,
    "conditions": [
      "low_frequency",
      "high_frequency"
    ],
    "n_per_condition_realised": [
      {
        "condition": "low_frequency",
        "n": 80
      },
      {
        "condition": "high_frequency",
        "n": 80
      }
    ],
    "stimuli_file": "output/stimuli/en_freqcontrast_english_stimuli_R.csv",
    "stimuli_sha256": "8e507400b5cca733b1f4c574501ccd297d5dbf160759322df1b8c27b8b20cc82"
  },
