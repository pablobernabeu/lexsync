{
  "lexsync_datasheet_version": "1.0",
  "design": {
    "name": "en_freqcontrast",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "High versus low frequency English words, matched on length, neighbourhood density and OLD20.",
    "n_per_condition": 80
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en.csv",
    "sha256": "c20549b920d816809d11cfa673ad0df1dd70d3e73176ee66cbec18021627f65d",
    "provenance": "see corpora/ATTRIBUTION.md for corpus licence and citation"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "letters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean positional bigram probability"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "candidate_pool": [
      {
        "condition": "high_frequency",
        "n_candidates": 544
      },
      {
        "condition": "low_frequency",
        "n_candidates": 4295
      }
    ],
    "cross_engine": "byte-identical"
  },
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ condition + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017); fit with lme4 in R or pymer4/statsmodels in Python."
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0.027,
      "ci_low": -0.235,
      "ci_high": 0.289,
      "var_ratio": 0.895,
      "tost_p": 0.0016,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "manipulated/free",
      "cohens_d": 5.272,
      "ci_low": 5.01,
      "ci_high": 5.533,
      "var_ratio": 0.213,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "n_density",
      "role": "controlled",
      "cohens_d": 0.038,
      "ci_low": -0.224,
      "ci_high": 0.299,
      "var_ratio": 0.804,
      "tost_p": 0.002,
      "equivalent": true
    },
    {
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": 0.009,
      "ci_low": -0.252,
      "ci_high": 0.271,
      "var_ratio": 0.914,
      "tost_p": 0.0011,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": null,
  "items": {
    "n_total": 160,
    "n_conditions": 2,
    "conditions": [
      "low_frequency",
      "high_frequency"
    ],
    "stimuli_file": "output/stimuli/en_freqcontrast_english_stimuli_R.csv",
    "stimuli_sha256": "85acf22715b0e0110e2ebb9e233ec69db96f7cd76edf7700b41d2afcce76f3ee"
  },
  "reproducibility": {
    "seed": 2026,
    "versions": {
      "engine": "R",
      "lexsync": "0.1.0",
      "R": "4.6.1",
      "readr": "2.2.0",
      "stringdist": "0.9.17",
      "jsonlite": "2.0.0",
      "digest": "0.6.39"
    }
  },
  "artifacts": [
