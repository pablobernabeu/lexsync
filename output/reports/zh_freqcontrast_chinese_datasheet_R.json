      "var_ratio": 0.648,
      "tost_p": 0.0037,
      "equivalent": true
    },
    {
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": 0.106,
      "ci_low": -0.155,
      "ci_high": 0.368,
      "var_ratio": 0.442,
      "tost_p": 0.0069,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": null,
  "items": {
    "n_total": 160,
    "n_conditions": 2,
    "conditions": [
