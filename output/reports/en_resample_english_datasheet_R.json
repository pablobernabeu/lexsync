{
  "lexsync_datasheet_version": "1.1",
  "design": {
    "name": "en_resample",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "High versus low frequency English words in three disjoint matched item sets (items as a random factor).",
    "n_per_condition": 40
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en.csv",
    "sha256": "575833489e04d6a4001fda56a56e3daa383811dece1f819c44060ee79ca56976",
    "provenance": "wordfreq (Speer, 2022), data CC BY-SA 4.0; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_density",
      "old20"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "candidate_pool": [
      {
        "condition": "high_frequency",
        "n_candidates": 462
      },
      {
        "condition": "low_frequency",
        "n_candidates": 7479
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "the trial outcome (e.g. reaction time or accuracy)",
    "suggested_model": "response ~ condition + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017). The formula is lme4 syntax, for lme4 in R or pymer4 in Python; statsmodels MixedLM cannot take it directly and needs the random effects restated in its own arguments. The equivalence tests in the realised control are post-selection diagnostics on deterministically selected items, not inferential tests over a sample."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0.044,
      "ci_low": -0.169,
      "ci_high": 0.257,
      "var_ratio": 0.862,
      "tost_p": 0.0002,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "manipulated/free",
      "cohens_d": 5.382,
      "ci_low": 5.169,
      "ci_high": 5.595,
      "var_ratio": 0.585,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "n_density",
      "role": "controlled",
      "cohens_d": 0.032,
      "ci_low": -0.182,
      "ci_high": 0.245,
      "var_ratio": 0.865,
      "tost_p": 0.0002,
      "equivalent": true
    },
    {
      "dimension": "old20",
      "role": "controlled",
      "cohens_d": 0.017,
      "ci_low": -0.196,
      "ci_high": 0.23,
      "var_ratio": 0.898,
      "tost_p": 0.0001,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": {
    "n_sets": 3,
    "disjoint": true
  },
  "items": {
    "n_total": 240,
    "n_conditions": 2,
    "conditions": [
      "low_frequency",
      "high_frequency"
    ],
    "stimuli_file": "output/stimuli/en_resample_english_stimuli_R.csv",
    "stimuli_sha256": "b51397019b42e5efbd18154a45a5ce5db62296403ecfc8d1ecb7d75f3581b79b"
  },
  "reproducibility": {
    "seed": 2026,
    "versions": {
      "engine": "R",
      "lexsync": "0.1.0",
      "R": "4.3.3",
      "readr": "2.1.5",
      "stringdist": "0.9.12",
      "jsonlite": "1.8.8",
      "digest": "0.6.34",
      "yaml": "2.3.8",
      "stringi": "1.8.3",
      "os": "Linux x86_64"
    },
    "design_sha256": "8c72dcaf1297f3940782caf8fa1cf04edd9b19e9592f30564929372c5e19f66f",
    "schema_sha256": "bc66a5fd3a65b0f93271d18958f18ae7037f00f7a21ae6380632c55de49e7ca0"
  },
  "artifacts": [
