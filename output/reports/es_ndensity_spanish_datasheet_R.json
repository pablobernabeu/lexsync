      "ci_low": -0.262,
      "ci_high": 0.262,
      "tost_p": 0.0009,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "controlled",
      "cohens_d": 0,
      "ci_low": -0.262,
      "ci_high": 0.262,
      "tost_p": 0.0009,
      "equivalent": true
    },
    {
      "dimension": "n_density",
