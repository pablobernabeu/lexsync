      "cohens_d": 2.128,
      "ci_low": 1.866,
      "ci_high": 2.389,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "old20",
      "role": "manipulated/free",
      "cohens_d": -2.421,
      "ci_low": -2.683,
      "ci_high": -2.159,
      "tost_p": 1,
      "equivalent": false
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
  "resampling": null,
  "items": {
