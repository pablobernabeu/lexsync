      "ci_low": -0.143,
      "ci_high": 0.535,
      "var_ratio": 0.556,
      "tost_p": 0.0697,
      "equivalent": false
    },
    {
      "dimension": "old20",
      "role": "manipulated/free",
      "cohens_d": -0.082,
      "ci_low": -0.422,
      "ci_high": 0.257,
      "var_ratio": 0.893,
      "tost_p": 0.0218,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
