      "cohens_d": -0.082,
      "ci_low": -0.422,
      "ci_high": 0.257,
      "tost_p": 0.0218,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1
  },
