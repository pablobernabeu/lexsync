{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "es_gender_repro",
    "language": "spanish",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "Reproducing Gonzalez Alonso et al. (2025): feminine versus masculine Spanish words matched on word frequency and number of letters, the origin study's natural-language gender-assignment task.",
    "n_per_condition": 48
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/es_gender.csv",
    "sha256": "0f77aec3fe307ed38f1e69e69f7c80ee93e38ffb8c0622b817fd2c26d15114d5",
    "provenance": "wordfreq (Speer, 2022), data CC BY-SA 4.0; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "frequency",
      "length"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 0.111111111111111,
      "n_density": 2,
      "old20": 2
    },
    "tie_break": {
      "rule": "hash",
      "salt": "lexsync-tie-v1"
    },
    "candidate_pool": [
      {
        "condition": "feminine",
        "n_candidates": 5130
      },
      {
        "condition": "masculine",
        "n_candidates": 4164
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "reaction time from the onset of `{word}`; responses collected for 2800 ms; a response ends the trial",
    "suggested_model": "response ~ condition + scale(frequency, scale = FALSE) + scale(length, scale = FALSE) + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). The matched dimensions enter as centred covariates, computed from the stimuli file's own columns, because matching leaves residual differences that the analysis can adjust for (Sassenhagen & Alday, 2016). Begin with random slopes for condition, the manipulated factor, by subject and, where it varies within items, by item (Barr et al., 2013); the matched covariates enter as fixed effects only. If the model is singular or fails to converge, simplify it as Matuschek et al. (2017) describe. The formula is lme4 syntax, for lme4 in R or pymer4 in Python; statsmodels MixedLM cannot take it directly and needs the random effects restated in its own arguments. The equivalence tests in the realised control are post-selection diagnostics on deterministically selected items, not inferential tests over a sample."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "condition": "masculine",
      "reference": "feminine",
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0,
      "ci_low": -0.339,
      "ci_high": 0.339,
      "var_ratio": 1,
      "tost_p": 0.0081,
      "equivalent": true,
      "mean_diff": 0
    },
    {
      "condition": "masculine",
      "reference": "feminine",
      "dimension": "frequency",
      "role": "controlled",
      "cohens_d": 0.021,
      "ci_low": -0.319,
      "ci_high": 0.36,
      "var_ratio": 0.009,
      "tost_p": 0.0105,
      "equivalent": true,
      "mean_diff": 0.008
    },
    {
      "condition": "masculine",
      "reference": "feminine",
      "dimension": "n_density",
      "role": "uncontrolled",
      "cohens_d": 0.147,
      "ci_low": -0.193,
      "ci_high": 0.486,
      "var_ratio": 0.522,
      "tost_p": 0.0433,
      "equivalent": true,
      "mean_diff": 0.417
    },
    {
      "condition": "masculine",
      "reference": "feminine",
      "dimension": "old20",
      "role": "uncontrolled",
      "cohens_d": -0.015,
      "ci_low": -0.354,
      "ci_high": 0.324,
      "var_ratio": 0.821,
      "tost_p": 0.0098,
      "equivalent": true,
      "mean_diff": -0.01
    },
    {
      "condition": "masculine",
      "reference": "feminine",
      "dimension": "n_syllables",
      "role": "uncontrolled",
      "cohens_d": 0.129,
      "ci_low": -0.211,
      "ci_high": 0.468,
      "var_ratio": 1.478,
      "tost_p": 0.0361,
      "equivalent": true,
      "mean_diff": 0.104
    },
    {
      "condition": "masculine",
      "reference": "feminine",
      "dimension": "bigram_freq",
      "role": "uncontrolled",
      "cohens_d": 0.235,
      "ci_low": -0.105,
      "ci_high": 0.575,
      "var_ratio": 1.497,
      "tost_p": 0.0987,
      "equivalent": false,
      "mean_diff": 0.001
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "feminine",
        "n_trials": 48
      },
      {
        "list": 1,
        "condition": "masculine",
        "n_trials": 48
      }
    ],
    "versions": 1,
    "assignment": "version = ((participant - 1) mod 1) + 1 unless a version is given at launch"
  },
  "presentation": {
    "response_windows": [
      {
        "event": 3,
        "from": "onset",
        "window_ms": 2800
      }
    ]
  },
  "resampling": null,
  "items": {
    "n_total": 96,
    "n_conditions": 2,
    "conditions": [
      "masculine",
      "feminine"
    ],
    "n_per_condition_realised": [
      {
        "condition": "masculine",
        "n": 48
      },
      {
        "condition": "feminine",
        "n": 48
      }
    ],
    "stimuli_file": "output/stimuli/es_gender_repro_spanish_stimuli_R.csv",
    "stimuli_sha256": "ffd50635e93d6e6cd5904efbf53bdada3b05170674ad1d938342df315e21d3a4"
