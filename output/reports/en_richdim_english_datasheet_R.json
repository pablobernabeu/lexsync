{
  "lexsync_datasheet_version": "1.0",
  "design": {
    "name": "en_richdim",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "High versus low frequency English words, matched on length, syllable count and bigram frequency (a phonotactic-probability proxy).",
    "n_per_condition": 60
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en.csv",
    "sha256": "c20549b920d816809d11cfa673ad0df1dd70d3e73176ee66cbec18021627f65d",
    "provenance": "see corpora/ATTRIBUTION.md for corpus licence and citation"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "letters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean positional bigram probability"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_syllables",
      "bigram_freq"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    }
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0.015,
      "ci_low": -0.287,
      "ci_high": 0.318,
      "tost_p": 0.0045,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "manipulated/free",
      "cohens_d": 5.572,
      "ci_low": 5.269,
      "ci_high": 5.875,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "n_density",
      "role": "manipulated/free",
      "cohens_d": 0.076,
      "ci_low": -0.226,
      "ci_high": 0.379,
      "tost_p": 0.011,
      "equivalent": true
    },
    {
      "dimension": "old20",
      "role": "manipulated/free",
      "cohens_d": 0.078,
      "ci_low": -0.224,
      "ci_high": 0.381,
      "tost_p": 0.0113,
      "equivalent": true
    },
    {
      "dimension": "n_syllables",
      "role": "controlled",
