{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "en_richdim",
    "language": "english",
    "paradigm": "factorial",
    "source": "corpus",
    "description": "High versus low frequency English words, matched on length, syllable count and bigram frequency (a phonotactic-probability proxy).",
    "n_per_condition": 60
  },
  "materials_source": {
    "type": "corpus",
    "path": "corpora/derived/en.csv",
    "sha256": "575833489e04d6a4001fda56a56e3daa383811dece1f819c44060ee79ca56976",
    "provenance": "wordfreq (Speer, 2022), data CC BY-SA 4.0; full corpus licence and citation at https://github.com/pablobernabeu/lexsync/blob/main/corpora/ATTRIBUTION.md"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "standardised_euclidean",
    "match_on": [
      "length",
      "n_syllables",
      "bigram_freq"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2
    },
    "tie_break": {
      "rule": "bytes"
    },
    "candidate_pool": [
      {
        "condition": "high_frequency",
        "n_candidates": 462
      },
      {
        "condition": "low_frequency",
        "n_candidates": 7479
      }
    ],
    "cross_engine": "byte-identical"
  },
  "relational": null,
  "analysis": {
    "response": "reaction time from the onset of `{word}`; responses collected for 2500 ms; a response ends the trial",
    "suggested_model": "response ~ condition + (1 + condition | subject) + (1 | item)",
    "note": "Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with this maximal structure (Barr et al., 2013) and reduce it if the model does not converge (Matuschek et al., 2017). The formula is lme4 syntax, for lme4 in R or pymer4 in Python; statsmodels MixedLM cannot take it directly and needs the random effects restated in its own arguments. The equivalence tests in the realised control are post-selection diagnostics on deterministically selected items, not inferential tests over a sample."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "dimension": "length",
      "role": "controlled",
      "cohens_d": 0.015,
      "ci_low": -0.287,
      "ci_high": 0.318,
      "var_ratio": 0.935,
      "tost_p": 0.0045,
      "equivalent": true
    },
    {
      "dimension": "frequency",
      "role": "manipulated/free",
      "cohens_d": 5.572,
      "ci_low": 4.903,
      "ci_high": 6.241,
      "var_ratio": 0.579,
      "tost_p": 1,
      "equivalent": false
    },
    {
      "dimension": "n_density",
      "role": "manipulated/free",
      "cohens_d": 0.076,
      "ci_low": -0.226,
      "ci_high": 0.379,
      "var_ratio": 0.723,
      "tost_p": 0.011,
      "equivalent": true
    },
    {
      "dimension": "old20",
      "role": "manipulated/free",
      "cohens_d": 0.078,
      "ci_low": -0.225,
      "ci_high": 0.381,
      "var_ratio": 0.404,
      "tost_p": 0.0113,
      "equivalent": true
    },
    {
      "dimension": "n_syllables",
      "role": "controlled",
      "cohens_d": 0.174,
      "ci_low": -0.129,
      "ci_high": 0.477,
      "var_ratio": 0.585,
      "tost_p": 0.0383,
      "equivalent": true
    },
    {
      "dimension": "bigram_freq",
      "role": "controlled",
      "cohens_d": 0.01,
      "ci_low": -0.293,
      "ci_high": 0.312,
      "var_ratio": 0.96,
      "tost_p": 0.0041,
      "equivalent": true
    }
  ],
  "counterbalancing": {
    "recipe": "factorial",
    "lists": 1,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "high_frequency",
        "n_trials": 60
      },
      {
        "list": 1,
        "condition": "low_frequency",
        "n_trials": 60
      }
    ],
    "versions": 1,
    "assignment": "version = ((participant - 1) mod 1) + 1 unless a version is given at launch"
  },
  "presentation": {
    "response_windows": [
      {
        "event": 3,
        "from": "onset",
        "window_ms": 2500
      }
    ]
  },
  "resampling": null,
  "items": {
    "n_total": 120,
    "n_conditions": 2,
    "conditions": [
      "low_frequency",
      "high_frequency"
    ],
    "stimuli_file": "output/stimuli/en_richdim_english_stimuli_R.csv",
    "stimuli_sha256": "36329804d813e465700b7a1777cf2da35d689ce6f4624857615b67515340f373"
  },
  "reproducibility": {
