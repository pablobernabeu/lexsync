      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "continuous even-spread (predictor spanned, controls banded)",
    "predictor": "target.frequency",
    "controls": [
      "target.length",
      "pair.overlap"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2,
      "target.length": 1.5,
      "pair.overlap": 1.5
    },
    "cross_engine": "byte-identical"
  },
  "relational": {
    "members": [
      "prime",
      "target"
    ],
    "n_pairs": 8,
    "member_lexicon": "corpora/derived/en_v2.csv",
    "member_lexicon_sha256": "46815cd56ac036cb841460a2ea6205ac374eddb6ca26275bb1a2fbafc7c5d626",
    "member_dimensions": [
      "freq_zipf",
      "frequency",
      "in_subtlex_us",
      "length",
      "lowercase_share",
      "n_density",
      "n_density_raw",
      "n_syllables",
      "nonstandard",
      "old20",
      "old20_raw",
      "reference_member"
    ],
    "relational_dimensions": [
      "pair.lev",
      "pair.overlap"
    ]
  },
  "analysis": {
    "response": "reaction time from the onset of `{target}`; responses collected for 2800 ms; a response ends the trial",
    "suggested_model": "response ~ condition * target.frequency + target.length + pair.overlap + (1 + condition * target.frequency | subject) + (1 + condition | item)",
    "note": "The predictor is kept continuous and analysed by regression or a mixed model rather than dichotomised (Kuperman, 2015; Liben-Nowell et al., 2019); the controls enter as covariates. Crossed random effects for subjects and items guard against the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008). Begin with random slopes for condition, target.frequency and their interaction by subject and for condition by item (Barr et al., 2013); the controls enter as fixed effects only. Centre target.frequency and sum-code condition, so that each main effect is estimated at the average of the other. If the model is singular or fails to converge, simplify it as Matuschek et al. (2017) describe. Dotted dimension names are valid in R formulas but must be quoted as Q(\"...\") in Patsy-style Python interfaces."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
