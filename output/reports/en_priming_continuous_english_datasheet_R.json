{
  "lexsync_datasheet_version": "1.2",
  "design": {
    "name": "en_priming_continuous",
    "language": "english",
    "paradigm": "priming",
    "source": "table",
    "description": "Prime-target pairs selected to span target frequency continuously, with target length and prime-target orthographic overlap held near-constant; Latin-square counterbalanced over two lists.",
    "n_per_condition": 8
  },
  "materials_source": {
    "type": "table",
    "path": "items/priming_pairs_en.csv",
    "sha256": "088f506b3166368bb11b3b271a50ed33c52ba913205bcaa642c5b4ebec4a091a",
    "provenance": "user-supplied item table"
  },
  "dimensions": {
    "length": {
      "type": "derived",
      "compute": "n_letters",
      "unit": "characters"
    },
    "frequency": {
      "type": "column",
      "column": "freq_zipf",
      "unit": "Zipf"
    },
    "n_density": {
      "type": "derived",
      "compute": "coltheart_n",
      "unit": "neighbours"
    },
    "old20": {
      "type": "derived",
      "compute": "old20",
      "unit": "mean Levenshtein distance"
    },
    "n_syllables": {
      "type": "derived",
      "compute": "vowel_groups",
      "unit": "syllables (orthographic estimate)"
    },
    "bigram_freq": {
      "type": "derived",
      "compute": "mean_bigram_probability",
      "unit": "mean bigram probability (type-based, non-positional)"
    }
  },
  "selection": {
    "method": "continuous even-spread (predictor spanned, controls banded)",
    "predictor": "target.frequency",
    "controls": [
      "target.length",
      "pair.overlap"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2,
      "target.length": 1.5,
      "pair.overlap": 1.5
    },
    "cross_engine": "byte-identical"
  },
  "relational": {
    "members": [
      "prime",
      "target"
    ],
    "n_pairs": 8,
    "member_lexicon": "corpora/derived/en.csv",
    "member_lexicon_sha256": "575833489e04d6a4001fda56a56e3daa383811dece1f819c44060ee79ca56976",
    "member_dimensions": [
      "freq_zipf",
      "frequency",
      "length",
      "n_density",
      "n_syllables",
      "old20"
    ],
    "relational_dimensions": [
      "pair.lev",
      "pair.overlap"
    ]
  },
  "analysis": {
    "response": "reaction time from the onset of `{target}`; responses collected for 2800 ms; a response ends the trial",
    "suggested_model": "response ~ target.frequency + target.length + pair.overlap + (1 + target.frequency | subject) + (1 | item)",
    "note": "The predictor is kept continuous and analysed by regression or a mixed model rather than dichotomised (Kuperman, 2015; Liben-Nowell et al., 2019); the controls enter as covariates. Crossed random effects for subjects and items guard the language-as-fixed-effect fallacy (Clark, 1973; Baayen et al., 2008); reduce the structure if it does not converge (Matuschek et al., 2017). Dotted dimension names are valid in R formulas but must be quoted as Q(\"...\") in Patsy-style Python interfaces."
  },
  "equivalence": {
    "bound_d": 0.5,
    "alpha": 0.05
  },
  "realised_control": [
    {
      "dimension": "target.frequency",
      "role": "predictor",
      "pearson_r": null,
      "predictor_span": 1.45
    },
    {
      "dimension": "target.length",
      "role": "control",
      "pearson_r": -0.292,
      "predictor_span": 1.45
    },
    {
      "dimension": "pair.overlap",
      "role": "control",
      "pearson_r": -0.227,
      "predictor_span": 1.45
    }
  ],
  "counterbalancing": {
    "recipe": "latin_square_target",
    "lists": 2,
    "complete": true,
    "issues": [],
    "cells": [
      {
        "list": 1,
        "condition": "related",
        "n_trials": 4
      },
      {
        "list": 1,
        "condition": "unrelated",
        "n_trials": 4
      },
      {
        "list": 2,
        "condition": "related",
        "n_trials": 4
      },
      {
        "list": 2,
        "condition": "unrelated",
        "n_trials": 4
      }
    ],
    "versions": 2,
    "assignment": "version = ((participant - 1) mod 2) + 1 unless a version is given at launch"
  },
  "presentation": {
    "response_windows": [
      {
        "event": 5,
        "from": "onset",
        "window_ms": 2800
      }
    ]
  },
  "resampling": null,
