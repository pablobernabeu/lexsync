    }
  },
  "selection": {
    "method": "continuous even-spread (predictor spanned, controls banded)",
    "predictor": "target.frequency",
    "controls": [
      "target.length",
      "pair.overlap"
    ],
    "tolerance_k": {
      "length": 2,
      "frequency": 1,
      "n_density": 2,
      "old20": 2,
