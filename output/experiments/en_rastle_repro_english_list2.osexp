---
API: 2.1
OpenSesame: 3.3.14
Platform: nt
---
set width 1024
set uniform_coordinates yes
set title "lexsync: en_rastle_repro (english)"
set subject_nr 0
set start lexsync_experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend legacy
set round_decimals 2
set mouse_backend legacy
set keyboard_backend legacy
set height 768
set fullscreen no
set foreground white
set font_size 32
set font_family mono
set description "Generated by lexsync"
set coordinates uniform
set compensation 0
set color_backend legacy
set clock_backend legacy
set canvas_backend xpyriment
set background black

define inline_script lexsync_trigger_setup
	set description "Load the trial texts and open the trigger device with a test-mode fallback"
	set _run ""
	___prepare__
	import csv as _csv
	with open(pool[u'en_rastle_repro_english_list2_opensesame_text.csv'], encoding=u'utf-8-sig', newline=u'') as _f:
	    _LEXSYNC_ROWS = {int(_r[u'lexsync_row']): _r for _r in _csv.DictReader(_f)}
	def _lexsync_row():
	    return _LEXSYNC_ROWS[int(var.get(u'lexsync_row', _eval=False))]
	var.trigger_backend = u'parallel'
	var.parallel_port_address = 0x0378
	var.test_mode = u'no'
	import time
	def _printer(code):
	    print(u'[lexsync test trigger] %d' % int(code))
	    time.sleep(0.01)
	    print(u'[lexsync test trigger] 0')
	send_trigger = _printer
	try:
	    if var.trigger_backend == u'serial':
	        import serial
	        import serial.tools.list_ports
	        _ports = serial.tools.list_ports.comports()
	        if _ports:
	            _sp = serial.Serial(_ports[0].device)
	            def send_trigger(code):
	                _sp.write(int(code).to_bytes(1, 'big'))
	                time.sleep(0.01)
	                _sp.write((0).to_bytes(1, 'big'))
	        else:
	            var.test_mode = u'yes'
	    else:
	        from ctypes import windll
	        _io = windll.dlportio
	        _addr = int(var.parallel_port_address)
	        def send_trigger(code):
	            _io.DlPortWritePortUchar(_addr, int(code))
	            time.sleep(0.01)
	            _io.DlPortWritePortUchar(_addr, 0)
	except Exception as _exc:
	    var.test_mode = u'yes'
	    print(u'lexsync: trigger device unavailable; test mode.')
	send_trigger(0)
	__end__

define inline_script lexsync_version_check
	set description "Warn when the subject number belongs to another version"
	set _prepare ""
	___run__
	_version = 2
	_versions = 2
	try:
	    _p = int(var.get(u'subject_nr', 0, _eval=False))
	except (TypeError, ValueError):
	    _p = 0
	_expected = (_p - 1) % _versions + 1
	if _expected != _version:
	    c = Canvas()
	    c.text(u'Participant %d would normally run version %d, and this file runs version %d. Press space to continue with this one or escape to stop.' % (_p, _expected, _version))
	    c.show()
	    _key, _t = Keyboard(keylist=[u'space', u'escape'], timeout=None).get_key()
	    if _key == u'escape':
	        raise RuntimeError(u'lexsync: stopped at the version check, because participant %d would normally run version %d.' % (_p, _expected))
	__end__

define inline_script lexsync_e0
	set description "Show stimulus and send onset-aligned trigger"
	set _prepare ""
	___run__
	c = Canvas()
	c.text(u'+')
	var.onset_time = c.show()
	clock.sleep(500)
	__end__

define inline_script lexsync_e1
	set description "Show stimulus and send onset-aligned trigger"
	set _prepare ""
	___run__
	c = Canvas()
	c.text(_lexsync_row()[u'prime'])
	var.onset_time = c.show()
	send_trigger(20)
	clock.sleep(50)
	__end__

define inline_script lexsync_e2
	set description "Show stimulus and send onset-aligned trigger"
	set _prepare ""
	___run__
	c = Canvas()
	c.text(u'#####')
	var.onset_time = c.show()
	clock.sleep(33)
	__end__

define inline_script lexsync_e3
	set description "Show stimulus and send onset-aligned trigger"
	set _prepare ""
	___run__
	c = Canvas()
	c.text(_lexsync_row()[u'target'])
	var.onset_time = c.show()
	send_trigger(int(var.get(u'condition_trigger', _eval=False)))
	clock.sleep(800)
	__end__

define inline_script lexsync_e4_blank
	set description "Clear the screen for the response window"
	set _prepare ""
	___run__
	c = Canvas()
	c.show()
	__end__

define keyboard_response lexsync_e4
	set timeout 2000
	set flush yes
	set duration keypress
	set description "Collect a response"
	set allowed_responses "left;right"

define inline_script lexsync_e5
	set description "Show stimulus and send onset-aligned trigger"
	set _prepare ""
	___run__
	c = Canvas()
	var.onset_time = c.show()
	clock.sleep(250)
	__end__

define sequence lexsync_trial
	set flush_keyboard yes
	set description "One trial: the paradigm event sequence"
	run lexsync_e0 always
	run lexsync_e1 always
	run lexsync_e2 always
	run lexsync_e3 always
	run lexsync_e4_blank always
	run lexsync_e4 always
	run lexsync_e5 always

define loop lexsync_loop
	set source_file "en_rastle_repro_english_list2_opensesame.csv"
	set source file
	set repeat 1
	set order sequential
	set description "Present each item once"
	run lexsync_trial

define sequence lexsync_experiment
	set flush_keyboard yes
	set description "Top-level experiment sequence"
	run lexsync_trigger_setup always
	run lexsync_version_check always
	run lexsync_loop always

