---
API: 2.1
OpenSesame: 3.3.14
Platform: nt
---
set width 1024
set uniform_coordinates yes
set title "lexsync: es_freqcontrast (spanish)"
set subject_nr 0
set start lexsync_experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend legacy
set round_decimals 2
set mouse_backend legacy
set keyboard_backend legacy
set height 768
set fullscreen no
set foreground white
set font_size 32
set font_family mono
set description "Generated by lexsync"
set coordinates uniform
set compensation 0
set color_backend legacy
set clock_backend legacy
set canvas_backend xpyriment
set background black

define inline_script lexsync_trigger_setup
	set description "Open the trigger device with a test-mode fallback"
	set _run ""
	___prepare__
	var.trigger_backend = u'parallel'
	var.parallel_port_address = 0x0378
	var.test_mode = u'no'
	import time
	def _printer(code):
	    print(u'[lexsync test trigger] %d' % int(code))
	    time.sleep(0.01)
	    print(u'[lexsync test trigger] 0')
	send_trigger = _printer
	try:
	    if var.trigger_backend == u'serial':
	        import serial
	        import serial.tools.list_ports
	        _ports = serial.tools.list_ports.comports()
	        if _ports:
	            _sp = serial.Serial(_ports[0].device)
	            def send_trigger(code):
	                _sp.write(int(code).to_bytes(1, 'big'))
	                time.sleep(0.01)
	                _sp.write((0).to_bytes(1, 'big'))
	        else:
	            var.test_mode = u'yes'
	    else:
	        from ctypes import windll
	        _io = windll.dlportio
	        _addr = int(var.parallel_port_address)
	        def send_trigger(code):
	            _io.DlPortWritePortUchar(_addr, int(code))
	            time.sleep(0.01)
	            _io.DlPortWritePortUchar(_addr, 0)
	except Exception as _exc:
	    var.test_mode = u'yes'
	    print(u'lexsync: trigger device unavailable; test mode.')
	send_trigger(0)
	__end__

define sketchpad lexsync_fixation
	set duration 500
	set description "Fixation cross"
	draw textline center=1 color=white font_family=mono font_size=40 html=yes show_if=always text="+" x=0 y=0 z_index=0

define sketchpad lexsync_word
	set duration 0
	set description "Target word; onset trigger sent by the next item"
	draw textline center=1 color=white font_family=mono font_size=40 html=yes show_if=always text="[word]" x=0 y=0 z_index=0

define inline_script lexsync_send_triggers
	set description "Send the onset trigger then the condition marker"
	set _prepare ""
	___run__
	send_trigger(var.target_word_trigger)
	send_trigger(var.condition_trigger)
	__end__

define keyboard_response lexsync_response
	set timeout 2000
	set flush yes
	set duration keypress
	set description "Collect a response"
	set allowed_responses "left;right"

define sequence lexsync_trial
	set flush_keyboard yes
	set description "Fixation, word with onset trigger, response"
	run lexsync_fixation always
	run lexsync_word always
	run lexsync_send_triggers always
	run lexsync_response always

define loop lexsync_loop
	set source_file "es_freqcontrast_spanish_opensesame.csv"
	set source file
	set repeat 1
	set order random
	set description "Present each stimulus once"
	run lexsync_trial

define sequence lexsync_experiment
	set flush_keyboard yes
	set description "Top-level experiment sequence"
	run lexsync_trigger_setup always
	run lexsync_loop always

