# --- R ---------------------------------------------------------------------
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj
R_workflow/..Rcheck/
R_workflow/*.Rcheck/
R_workflow/*.tar.gz
*.Rcheck/
/lexsync_*.tar.gz
R_workflow/src/*.o
R_workflow/src/*.so
R_workflow/src/*.dll
renv/library/
R_workflow/renv/library/
# `R CMD build` and devtools::build_vignettes() write these into the package
# directory. They are rendered copies of vignettes/, so committing them would
# publish a second, silently stale copy of every article.
R_workflow/doc/
R_workflow/Meta/
R_workflow/inst/doc/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
python_workflow/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Corpora (large raw downloads are fetched on demand) -------------------
corpora/raw/*
!corpora/raw/.gitkeep

# --- Quarto render intermediates -------------------------------------------
/.quarto/
manuscript/.quarto/
manuscript/manuscript_files/
manuscript/manuscript_cache/

# --- Documentation sites (generated; the docs workflow rebuilds and deploys) -
R_workflow/docs/
python_workflow/site/
/site/

# --- session build/check temporaries ---------------------------------------
/.rcheck_tmp/
/.regen_R.log
/.pkgdown_build.log
/.audit_findings.txt

# --- Credentials -----------------------------------------------------------
# lexsync handles no credentials of its own, so nothing here is expected to
# exist. These patterns are defensive: the repository is public, and an .Renviron
# or a .env is the ordinary way an R or Python secret reaches a working tree by
# accident. A commit that never happens needs no history rewrite.
.env
.env.*
.Renviron
*.pem
*.p12
*.pfx
*.key
id_rsa*
id_ed25519*

# --- Editor and local tool state -------------------------------------------
# .claude/launch.json is deliberately tracked: it is how anyone launches the two
# demo apps. Only the per-user settings file is local.
.vscode/
.idea/
*.swp
.claude/settings.local.json

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
