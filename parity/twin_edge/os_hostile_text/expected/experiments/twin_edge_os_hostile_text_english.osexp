---
API: 2.1
OpenSesame: 3.3.14
Platform: nt
---
set width 1024
set uniform_coordinates yes
set title "lexsync: twin_edge_os_hostile_text (english)"
set subject_nr 0
set start lexsync_experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend legacy
set round_decimals 2
set mouse_backend legacy
set keyboard_backend legacy
set height 768
set fullscreen no
set foreground white
set font_size 32
set font_family mono
set description "Generated by lexsync"
set coordinates uniform
set compensation 0
set color_backend legacy
set clock_backend legacy
set canvas_backend xpyriment
set background black

define inline_script lexsync_trigger_setup
	set description "Load the trial texts and open the trigger device with a test-mode fallback"
	set _run ""
	___prepare__
	import csv as _csv
	with open(pool[u'twin_edge_os_hostile_text_english_opensesame_text.csv'], encoding=u'utf-8-sig', newline=u'') as _f:
	    _LEXSYNC_ROWS = {int(_r[u'lexsync_row']): _r for _r in _csv.DictReader(_f)}
	def _lexsync_row():
	    return _LEXSYNC_ROWS[int(var.get(u'lexsync_row', _eval=False))]
	var.trigger_backend = u'parallel'
	var.parallel_port_address = 0x0378
	var.test_mode = u'no'
	def _printer(code):
	    print(u'[lexsync test trigger] %d' % int(code))
	send_trigger = _printer
	try:
	    if var.trigger_backend == u'serial':
	        import serial
	        import serial.tools.list_ports
	        _ports = serial.tools.list_ports.comports()
	        if _ports:
	            _sp = serial.Serial(_ports[0].device)
	            def send_trigger(code):
	                _sp.write(int(code).to_bytes(1, 'big'))
	        else:
	            var.test_mode = u'yes'
	    else:
	        from ctypes import windll
	        _io = windll.dlportio
	        _addr = int(var.parallel_port_address)
	        def send_trigger(code):
	            _io.DlPortWritePortUchar(_addr, int(code))
	except Exception as _exc:
	    var.test_mode = u'yes'
	    print(u'lexsync: trigger device unavailable; test mode.')
	send_trigger(0)
	_c = Canvas()
	_d = [_c.show() for _i in range(21)]
	_d = sorted(_b - _a for _a, _b in zip(_d, _d[1:]))
	_LEXSYNC_FRAME = (_d[9] + _d[10]) / 2.0
	if not 1.0 < _LEXSYNC_FRAME < 50.0:
	    _LEXSYNC_FRAME = 1000.0 / 60
	var.lexsync_frame_ms = _LEXSYNC_FRAME
	_LEXSYNC_HALF_FRAME = _LEXSYNC_FRAME / 2.0
	_LEXSYNC_HOLD = 50
	_lexsync_due = [None]
	def _lexsync_until(t):
	    _left = t - clock.time()
	    if _left > 0:
	        clock.sleep(_left)
	def _lexsync_onset(code, t0):
	    if _lexsync_due[0] is not None:
	        send_trigger(0)
	    send_trigger(code)
	    _lexsync_due[0] = t0 + _LEXSYNC_HOLD
	def _lexsync_reset():
	    send_trigger(0)
	    _lexsync_due[0] = None
	def _lexsync_wait(t):
	    if _lexsync_due[0] is not None and _lexsync_due[0] <= t:
	        _lexsync_until(_lexsync_due[0])
	        _lexsync_reset()
	    _lexsync_until(t)
	def _lexsync_key(kb, t):
	    if _lexsync_due[0] is not None and (t is None or _lexsync_due[0] <= t):
	        _left = _lexsync_due[0] - clock.time()
	        if _left > 0:
	            _key, _t = kb.get_key(timeout=_left)
	            if _key is not None:
	                return _key, _t
	        _lexsync_reset()
	    return kb.get_key(timeout=None if t is None else max(0, t - clock.time()))
	def _lexsync_end_hold():
	    if _lexsync_due[0] is not None:
	        _lexsync_until(_lexsync_due[0])
	        _lexsync_reset()
	def _lexsync_marker(code):
	    _lexsync_onset(code, clock.time())
	    _lexsync_end_hold()
	__end__

define inline_script lexsync_instructions
	set description "Show the instructions and wait for the space bar"
	set _prepare ""
	___run__
	c = Canvas()
	c.text(u'When a response is needed, press F or J. You will read each sentence one part at a time. Press the space bar to see the next part. Answer each question by pressing F for yes and J for no. Respond as quickly and accurately as you can.<br /><br />Press the space bar to begin.')
	c.show()
	_key, _t = Keyboard(keylist=[u'space', u'escape'], timeout=None).get_key()
	if _key == u'escape':
	    raise RuntimeError(u'lexsync: stopped at the instructions.')
	__end__

define inline_script lexsync_session_start
	set description "Mark the start of the trials with 254"
	set _prepare ""
	___run__
	_lexsync_marker(254)
	__end__

define inline_script lexsync_session_end
	set description "Mark the end of the trials with 255"
	set _prepare ""
	___run__
	_lexsync_marker(255)
	__end__

define inline_script lexsync_trial_start
	set description "Clear the previous trial's responses"
	set _prepare ""
	___run__
	var.response = u''
	var.response_time = u''
	var.timed_out = u''
	var.correct = u''
	var.question_response = u''
	var.question_rt = u''
	var.lexsync_region_rts = u''
	__end__

define inline_script lexsync_e0
	set description "Show stimulus and send onset-aligned trigger"
	___prepare__
	_lexsync_c_e0 = Canvas()
	_lexsync_c_e0.text(u'+')
	__end__
	___run__
	_t0 = _lexsync_c_e0.show()
	var.onset_time = _t0
	_lexsync_wait(_t0 + 500 - _LEXSYNC_HALF_FRAME)
	__end__

define inline_script lexsync_e1
	set description "Show the stimulus and collect the response from its onset"
	___prepare__
	_lexsync_c_e1 = Canvas()
	_lexsync_c_e1.text(_lexsync_row()[u'word'])
	_lexsync_c_e1_blank = Canvas()
	__end__
	___run__
	_t0 = _lexsync_c_e1.show()
	var.onset_time = _t0
	_lexsync_onset(int(var.get(u'condition_trigger', _eval=False)), _t0)
	_kb = Keyboard(keylist=[u'f', u'j'])
	_kb.flush()
	_key, _t = _lexsync_key(_kb, _t0 + int(float(var.get(u'word_ms', _eval=False))) - _LEXSYNC_HALF_FRAME)
	if _key is None:
	    _lexsync_c_e1_blank.show()
	    _key, _t = _lexsync_key(_kb, _t0 + int(float(var.get(u'word_ms', _eval=False))) + 2000)
	var.response = _key
	var.response_time = u'' if _key is None else _t - _t0
	var.timed_out = 1 if _key is None else 0
	_want = str(_lexsync_row().get(u'answer', u'')).strip()
	_got = u'' if _key is None else str(_key).strip()
	var.correct = (1 if _got == _want else 0) if _want else u''
	__end__

define inline_script lexsync_e2
	set description "Practice feedback"
	___prepare__
	if _lexsync_row().get(u'block', u'main') in [u'practice']:
	    _lexsync_c_e2 = {u'correct': Canvas(), u'incorrect': Canvas(), u'no_response': Canvas()}
	    _lexsync_c_e2[u'correct'].text(u'Correct')
	    _lexsync_c_e2[u'incorrect'].text(u'Incorrect')
	    _lexsync_c_e2[u'no_response'].text(u'Too slow')
	__end__
	___run__
	if _lexsync_row().get(u'block', u'main') in [u'practice']:
	    _want = str(_lexsync_row().get(u'answer', u'')).strip()
	    _got = var.get(u'response', u'', _eval=False)
	    _got = u'' if _got is None else str(_got).strip()
	    if _got in (u'', u'None'): _msg = u'no_response'
	    elif _got == _want: _msg = u'correct'
	    else: _msg = u'incorrect'
	    _t0 = _lexsync_c_e2[_msg].show()
	    _lexsync_wait(_t0 + 600 - _LEXSYNC_HALF_FRAME)
	__end__

define inline_script lexsync_e3
	set description "Self-paced reading region by region"
	___prepare__
	_lexsync_c_e3 = []
	for _r in [r for r in _lexsync_row()[u'sentence'].split(u'|') if r != u'']:
	    _c = Canvas()
	    _c.text(_r)
	    _lexsync_c_e3.append(_c)
	__end__
	___run__
	_crit = int(var.get(u'critical_region', 0, _eval=False) or 0)
	_kb = Keyboard(keylist=[u'space'], timeout=None)
	_rts = []
	for _i, _c in enumerate(_lexsync_c_e3, start=1):
	    _t0 = _c.show()
	    if _i == _crit: _lexsync_onset(int(var.get(u'item_trigger', _eval=False)), _t0)
	    _kb.flush()
	    _key, _t = _lexsync_key(_kb, None)
	    _rts.append(u'%.1f' % (_t - _t0))
	var.lexsync_region_rts = u'|'.join(_rts)
	__end__

define inline_script lexsync_e4
	set description "Comprehension question"
	___prepare__
	_lexsync_c_e4 = Canvas()
	_lexsync_c_e4.text(_lexsync_row()[u'question'])
	__end__
	___run__
	_t0 = _lexsync_c_e4.show()
	_kb = Keyboard(keylist=[u'f', u'j'])
	_kb.flush()
	_key, _t = _lexsync_key(_kb, _t0 + 1003)
	var.question_response = _key
	var.question_rt = u'' if _key is None else _t - _t0
	__end__

define inline_script lexsync_e5_blank
	set description "Clear the screen for the response window"
	___prepare__
	_lexsync_c_e5_blank = Canvas()
	__end__
	___run__
	_lexsync_c_e5_blank.show()
	_lexsync_end_hold()
	__end__

define keyboard_response lexsync_e5
	set timeout 1001
	set flush yes
	set duration keypress
	set description "Collect a response"
	set allowed_responses "f;j"

define inline_script lexsync_e5_score
	set description "Record the timeout and the accuracy"
	set _prepare ""
	___run__
	_key = var.get(u'response', u'', _eval=False)
	_timed_out = _key is None or str(_key).strip() in (u'', u'None')
	var.timed_out = 1 if _timed_out else 0
	if _timed_out:
	    _key = None
	    var.response_time = u''
	_want = str(_lexsync_row().get(u'answer', u'')).strip()
	_got = u'' if _key is None else str(_key).strip()
	var.correct = (1 if _got == _want else 0) if _want else u''
	__end__

define inline_script lexsync_e6
	set description "Show stimulus and send onset-aligned trigger"
	___prepare__
	_lexsync_c_e6 = Canvas()
	__end__
	___run__
	_t0 = _lexsync_c_e6.show()
	var.onset_time = _t0
	_lexsync_wait(_t0 + int(float(var.get(u'iti_ms', _eval=False))) - _LEXSYNC_HALF_FRAME)
	__end__

define inline_script lexsync_record
	set description "Copy the trial's labels for the logger"
	set _prepare ""
	___run__
	_row = _lexsync_row()
	var.lexsync_condition = _row.get(u'condition', u'')
	var.lexsync_block = _row.get(u'block', u'')
	var.lexsync_answer = _row.get(u'answer', u'')
	__end__

define logger lexsync_logger
	set description "Log the trial"
	set auto_log yes

define sequence lexsync_trial
	set flush_keyboard yes
	set description "One trial: the paradigm event sequence"
	run lexsync_trial_start always
	run lexsync_e0 always
	run lexsync_e1 always
	run lexsync_e2 always
	run lexsync_e3 always
	run lexsync_e4 always
	run lexsync_e5_blank always
	run lexsync_e5 always
	run lexsync_e5_score always
	run lexsync_e6 always
	run lexsync_record always
	run lexsync_logger always

define loop lexsync_loop
	set source_file "twin_edge_os_hostile_text_english_opensesame.csv"
	set source file
	set repeat 1
	set order sequential
	set description "Present each item once"
	run lexsync_trial

define sequence lexsync_experiment
	set flush_keyboard yes
	set description "Top-level experiment sequence"
	run lexsync_trigger_setup always
	run lexsync_instructions always
	run lexsync_session_start always
	run lexsync_loop always
	run lexsync_session_end always

